{
  "name": "privta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "dev": "tsc && .venv/bin/python scripts/serve.py",
    "seed": ".venv/bin/python scripts/seed.py"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
